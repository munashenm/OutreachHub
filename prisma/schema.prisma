generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MarketingStatus {
  UNKNOWN
  CONSENT_REQUESTED
  CONSENTED
  EXISTING_CUSTOMER
  OPTED_OUT
  BOUNCED
  BLOCKED
}

enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  QUOTE_REQUESTED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ActivityType {
  PROSPECT_CREATED
  PROSPECT_EDITED
  PROSPECT_DELETED
  COMPANY_CREATED
  COMPANY_EDITED
  COMPANY_DELETED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  PROSPECT_ADDED_TO_CAMPAIGN
  MARKETING_STATUS_CHANGED
  LEAD_STATUS_CHANGED
  SUPPRESSION_ADDED
  SUPPRESSION_REMOVED
  EMAIL_SENT
  EMAIL_FAILED
  REPLY_RECEIVED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  MAILBOX_CONNECTED
  MAILBOX_DISCONNECTED
  RFQ_CREATED
  INBOX_UPDATED
  PRODUCT_CREATED
  QUOTE_SENT
  SUPPLIER_IMPORTED
  STOCK_SYNCED
  STORE_ORDERS_IMPORTED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  SENT
  FAILED
  SKIPPED
}

enum MailboxProvider {
  GOOGLE
  MICROSOFT
}

enum MailboxConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
}

enum InboxCategory {
  NEW_ENQUIRY
  RFQ
  PRICING_REQUEST
  PRODUCT_ENQUIRY
  ORDER_ENQUIRY
  SUPPORT
  CAMPAIGN_REPLY
  OTHER
}

enum RfqStatus {
  NEW
  SOURCING
  REVIEWING
  NEEDS_INFORMATION
  READY_TO_QUOTE
  QUOTE_PREPARED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  passwordResetTokens  PasswordResetToken[]
  activities           Activity[]         @relation("ActivityActor")
  suppressions         Suppression[]
  leadStatusChanges    LeadStatusHistory[]
  campaignProspectAdds CampaignProspect[] @relation("CampaignProspectAdder")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo              Boolean   @default(false)
  quoteSequence       Int       @default(0)
  storeName              String?
  storePublicUrl         String?
  storeBaseUrl           String?
  storeProvider          String    @default("urban-focus")
  storeKeyEncrypted      String?
  storeSecretEncrypted   String?
  minimumMarginPercent   Int       @default(0)
  autoQuoteMarginPercent Int       @default(15)
  autoSendMarginPercent  Int       @default(25)
  storeLastSyncAt        DateTime?
  storeLastError         String?
  followUpAfterDays      Int       @default(3)
  followUpLimit          Int       @default(2)
  quoteSettings          Json?
  createdAt           DateTime  @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  companies         Company[]
  prospects         Prospect[]
  campaigns         Campaign[]
  activities        Activity[]
  suppressions      Suppression[]
  leadStatusHistory LeadStatusHistory[]
  messages          Message[]
  campaignProspects CampaignProspect[]
  mailboxes         Mailbox[]
  emailTemplates    EmailTemplate[]
  rfqs              Rfq[]
  products          Product[]
  quotes            Quote[]
  suppliers         Supplier[]
  storeOrders       StoreOrder[]
  catalogueScans    StoreCatalogueScan[]
  catalogueItems    StoreCatalogueItem[]
  catalogueAudits   CatalogueAudit[]
  externalOffers    ExternalSourceOffer[]
  funnelEvents      SalesFunnelEvent[]
  sourcingTasks     SourcingTask[]
  attachments       StoredAttachment[]
  tenderAnalyses    TenderAnalysis[]
  inboundProcessing InboundMessageProcessing[]
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Company {
  id          String   @id @default(cuid())
  workspaceId String
  companyName String
  website     String?
  industry    String?
  companySize String?
  phone       String?
  country     String?
  province    String?
  city        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospects  Prospect[]
  activities Activity[]
  rfqs       Rfq[]

  @@index([workspaceId])
  @@index([workspaceId, companyName])
}

model Prospect {
  id              String          @id @default(cuid())
  workspaceId     String
  firstName       String
  lastName        String
  jobTitle        String?
  email           String
  phone           String?
  companyId       String?
  website         String?
  industry        String?
  country         String?
  province        String?
  city            String?
  source          String?
  linkedinUrl     String?
  notes           String?
  leadStatus      LeadStatus      @default(NEW)
  marketingStatus MarketingStatus @default(UNKNOWN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaignProspects CampaignProspect[]
  activities        Activity[]
  statusHistory     LeadStatusHistory[]
  messages          Message[]
  rfqs              Rfq[]
  storeOrders       StoreOrder[]

  @@unique([workspaceId, email])
  @@index([workspaceId, leadStatus])
  @@index([workspaceId, marketingStatus])
  @@index([workspaceId, lastName, firstName])
}

model Campaign {
  id               String         @id @default(cuid())
  workspaceId      String
  name             String
  description      String?
  status           CampaignStatus @default(DRAFT)
  senderAccount    String?
  dailyLimit       Int            @default(50)
  timezone         String         @default("UTC")
  sendingStartTime String         @default("08:00")
  sendingEndTime   String         @default("17:00")
  mailboxId        String?
  templateId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox      Mailbox?           @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  template     EmailTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  prospects    CampaignProspect[]
  suppressions Suppression[]
  messages     Message[]
  activities   Activity[]

  @@index([workspaceId, status])
}

model CampaignProspect {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String
  prospectId  String
  addedById   String?
  addedAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect  Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("CampaignProspectAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, prospectId])
  @@index([workspaceId])
  @@index([prospectId])
}

model Suppression {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  reason      String
  source      String?
  campaignId  String?
  userId      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

model LeadStatusHistory {
  id          String      @id @default(cuid())
  workspaceId String
  prospectId  String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String?
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect  Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([prospectId, createdAt])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  type        ActivityType
  actorId     String?
  prospectId  String?
  companyId   String?
  campaignId  String?
  summary     String
  metadata    Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  prospect  Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([prospectId])
  @@index([companyId])
  @@index([campaignId])
}

model Mailbox {
  id                     String          @id @default(cuid())
  workspaceId            String
  provider               MailboxProvider @default(GOOGLE)
  email                  String
  connectionStatus       MailboxConnectionStatus @default(CONNECTED)
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  tokenExpiresAt         DateTime
  historyId              String?
  lastSyncAt             DateTime?
  lastError              String?
  lastSuccessfulSendAt   DateTime?
  lastInboundSyncAt      DateTime?
  syncLeaseUntil         DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([workspaceId, provider, email])
  @@index([workspaceId])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  body        String
  htmlBody    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([workspaceId])
}

model Message {
  id          String           @id @default(cuid())
  workspaceId String
  campaignId  String?
  prospectId  String?
  direction   MessageDirection
  status      MessageStatus    @default(SENT)
  subject           String           @default("")
  body              String           @default("")
  snippet           String           @default("")
  fromEmail         String?
  fromName          String?
  internetMessageId String?
  category          InboxCategory?
  ignored           Boolean          @default(false)
  error             String?
  externalId        String?
  threadId          String?
  sentAt            DateTime?
  automationAt      DateTime?
  createdAt         DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect    Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  rfqs        Rfq[]
  attachments StoredAttachment[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, direction, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, threadId])
  @@index([campaignId, prospectId])
}

model Rfq {
  id              String    @id @default(cuid())
  workspaceId     String
  prospectId      String?
  companyId       String?
  sourceMessageId String
  subject         String
  description     String    @default("")
  notes           String    @default("")
  customerReference String @default("")
  deliveryLocation  String @default("")
  requiredDate      String @default("")
  acknowledgementSentAt DateTime?
  automationNote    String @default("")
  enquiryJson       Json?
  lostReason        String    @default("")
  respondedAt       DateTime?
  status          RfqStatus @default(NEW)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect      Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceMessage Message   @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  lines         RfqLine[]
  funnelEvents  SalesFunnelEvent[]
  sourcingTasks SourcingTask[]
  analyses      TenderAnalysis[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([sourceMessageId])
}

model RfqLine {
  id                     String   @id @default(cuid())
  workspaceId            String
  rfqId                  String
  description            String
  quantity               Decimal? @db.Decimal(12, 2)
  manufacturer           String   @default("")
  modelName              String   @default("")
  sku                    String   @default("")
  manufacturerPartNumber String   @default("")
  specifications         String   @default("")
  matchStatus            String   @default("NEEDS_PRODUCT_REVIEW")
  matchNote              String   @default("")
  productId              String?
  storeProductId         String   @default("")
  sourcedName            String   @default("")
  sourceKind             String   @default("")
  matchGrade             String   @default("")
  costStatus             String   @default("")
  stockNote              String   @default("")

  rfq     Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([rfqId])
  @@index([productId])
}

enum QuoteStatus {
  DRAFT
  SENT
}

model Product {
  id             String   @id @default(cuid())
  workspaceId    String
  sku            String
  name           String
  description    String   @default("")
  specifications String   @default("")
  imageUrls      String[] @default([])
  unitPriceCents        Int
  pendingUnitPriceCents Int?
  priceChangeFlagged    Boolean  @default(false)
  currency              String   @default("ZAR")
  active                Boolean  @default(true)
  stockOnHand           Int      @default(0)
  manufacturerPartNumber String   @default("")
  barcode                String   @default("")
  brand                  String   @default("")
  categoryName           String   @default("")
  slug                   String   @default("")
  seoTitle               String   @default("")
  metaDescription        String   @default("")
  reviewStatus           String   @default("")
  storeProductId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quoteLines QuoteLine[]
  supplierPrices SupplierPrice[]
  storeOrderLines StoreOrderLine[]
  catalogueItems StoreCatalogueItem[]
  rfqLines       RfqLine[]
  feedItems      SupplierFeedItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
}

model Quote {
  id          String      @id @default(cuid())
  workspaceId String
  rfqId       String
  status      QuoteStatus @default(DRAFT)
  currency    String      @default("ZAR")
  number      Int?
  issuedAt    DateTime?
  validDays   Int         @default(14)
  validUntil  DateTime?
  notes       String      @default("")
  documentMode String     @default("STANDARD")
  exportQuote Boolean     @default(false)
  references  String      @default("")
  pdf         Bytes?
  pdfFilename String      @default("")
  confidenceScore Int     @default(0)
  followUpCount   Int     @default(0)
  nextFollowUpAt  DateTime?
  followUpStoppedReason String @default("")
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rfq       Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lines     QuoteLine[]

  @@unique([workspaceId, number])
  @@index([workspaceId, rfqId])
}

model QuoteLine {
  id             String  @id @default(cuid())
  workspaceId    String
  quoteId        String
  productId      String?
  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unitPriceCents Int
  specifications String   @default("")
  imageUrls      String[] @default([])
  sku            String   @default("")
  modelName      String   @default("")
  manufacturerPartNumber String @default("")
  availability   String   @default("")
  leadTime       String   @default("")
  warranty       String   @default("")
  requirementText String  @default("")
  sourceKind     String   @default("")
  sourceUrl      String   @default("")
  sourceCheckedAt DateTime?
  matchGrade     String   @default("")
  costStatus     String   @default("")
  scheduleNumber String   @default("")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([workspaceId])
}

enum SupplierFeedType {
  JSON
  XML
  CSV_URL
  MANUAL_CSV
}

enum SupplierAuthType {
  NONE
  BEARER
  API_KEY_HEADER
  BASIC
}

enum SupplierVatMode {
  INCLUSIVE
  EXCLUSIVE
}

enum SupplierImportStatus {
  COMPLETED
  FAILED
}

model Supplier {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  country                String            @default("")
  notes                  String            @default("")
  markupPercent          Int               @default(0)
  feedType               SupplierFeedType  @default(JSON)
  feedEnabled            Boolean           @default(false)
  stockFeedUrl           String?
  authType               SupplierAuthType  @default(NONE)
  authHeaderName         String            @default("X-Api-Key")
  authUsername           String            @default("")
  stockFeedKeyEncrypted  String?
  vatMode                SupplierVatMode   @default(EXCLUSIVE)
  stockSyncIntervalMinutes Int             @default(60)
  priceSyncIntervalMinutes Int             @default(60)
  catalogueSyncIntervalMinutes Int        @default(60)
  preference             Int               @default(0)
  leadTimeDays           Int?
  fieldMapping           Json?
  lastStockSyncAt        DateTime?
  lastPriceSyncAt        DateTime?
  lastCatalogueSyncAt    DateTime?
  lastStockSyncError     String?
  createdAt              DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prices    SupplierPrice[]
  feedItems SupplierFeedItem[]
  imports   SupplierImport[]

  @@index([workspaceId])
}

model SupplierFeedItem {
  id                     String   @id @default(cuid())
  workspaceId            String
  supplierId             String
  supplierSku            String
  manufacturerPartNumber String   @default("")
  name                   String   @default("")
  brand                  String   @default("")
  description            String   @default("")
  specifications         String   @default("")
  category               String   @default("")
  imageUrls              String[] @default([])
  leadTimeDays           Int?
  costCents              Int      @default(0)
  costKnown              Boolean  @default(false)
  stockQty               Int      @default(0)
  stockKnown             Boolean  @default(false)
  barcode                String   @default("")
  productUrl             String   @default("")
  lastSeenAt             DateTime?
  productId              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([supplierId, supplierSku])
  @@index([workspaceId])
  @@index([productId])
}

model SupplierImport {
  id           String               @id @default(cuid())
  workspaceId  String
  supplierId   String
  filename     String
  uploadedAt   DateTime             @default(now())
  rowsRead     Int                  @default(0)
  rowsCreated  Int                  @default(0)
  rowsUpdated  Int                  @default(0)
  rowsRejected Int                  @default(0)
  status       SupplierImportStatus
  errorMessage String               @default("")
  rejections   Json                 @default("[]")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([supplierId, uploadedAt])
}

model SupplierPrice {
  id          String   @id @default(cuid())
  workspaceId String
  supplierId  String
  productId   String
  supplierSku             String
  manufacturerPartNumber String   @default("")
  offerName               String   @default("")
  brand                   String   @default("")
  description             String   @default("")
  specifications          String   @default("")
  imageUrls               String[] @default([])
  category                String   @default("")
  leadTimeDays            Int?
  costCents               Int
  costKnown               Boolean  @default(true)
  stockQty                Int      @default(0)
  stockKnown              Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([workspaceId])
  @@index([productId])
}

model ExternalSourceOffer {
  id                String   @id @default(cuid())
  workspaceId       String
  cacheKey          String   @default("")
  sourceName        String
  sourceUrl         String
  productName       String
  brand             String   @default("")
  model             String   @default("")
  sku               String   @default("")
  mpn               String   @default("")
  specifications    String   @default("")
  listedPriceCents  Int
  currency          String   @default("ZAR")
  vatIncluded       Boolean  @default(true)
  shippingCents     Int      @default(0)
  availability      String   @default("")
  deliveryEstimate  String   @default("")
  checkedAt         DateTime
  confidence        String   @default("MEDIUM")
  sourceType        String   @default("RETAILER")
  stockQty          Int?
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, cacheKey])
  @@index([workspaceId, checkedAt])
}

model StoreOrder {
  id           String   @id @default(cuid())
  workspaceId  String
  externalId   String
  number       String
  status       String
  email        String
  customerName String
  companyName  String   @default("")
  totalCents   Int
  currency     String   @default("ZAR")
  summary      String   @default("")
  placedAt     DateTime
  prospectId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prospect  Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  lines     StoreOrderLine[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, placedAt])
}

model StoreOrderLine {
  id          String @id @default(cuid())
  workspaceId String
  orderId     String
  productId   String?
  sku         String
  quantity    Int

  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([orderId])
  @@index([productId])
}

model StoreCatalogueScan {
  id          String    @id @default(cuid())
  workspaceId String
  status      String    @default("RUNNING")
  page        Int       @default(1)
  perPage     Int       @default(100)
  imported    Int       @default(0)
  total       Int?
  readOnly    Boolean   @default(true)
  stats       Json?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     StoreCatalogueItem[]

  @@index([workspaceId, status])
}

model StoreCatalogueItem {
  id                       String    @id @default(cuid())
  workspaceId              String
  scanId                   String
  storeProductId           String
  sku                      String    @default("")
  skuKey                   String    @default("")
  manufacturerPartNumber   String    @default("")
  mpnKey                   String    @default("")
  barcode                  String    @default("")
  barcodeKey               String    @default("")
  name                     String
  brand                    String    @default("")
  brandModelKey            String    @default("")
  category                 String    @default("")
  unitPriceCents           Int
  salePriceCents           Int?
  currency                 String    @default("ZAR")
  stockQuantity            Int       @default(0)
  stockStatus              String    @default("")
  description              String    @default("")
  specifications           String    @default("")
  imageUrls                String[]  @default([])
  published                Boolean   @default(false)
  slug                     String    @default("")
  url                      String    @default("")
  storeUpdatedAt           DateTime?
  reviewStatus             String    @default("BASELINE")
  reviewNote               String    @default("")
  duplicateKinds           String    @default("")
  mergedIntoStoreProductId String    @default("")
  productId                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scan      StoreCatalogueScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, storeProductId])
  @@index([workspaceId, skuKey])
  @@index([workspaceId, mpnKey])
  @@index([workspaceId, barcodeKey])
  @@index([workspaceId, brandModelKey])
  @@index([scanId])
  @@index([productId])
}

model CatalogueAudit {
  id             String   @id @default(cuid())
  workspaceId    String
  action         String
  storeProductId String   @default("")
  summary        String
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model SalesFunnelEvent {
  id          String   @id @default(cuid())
  workspaceId String
  rfqId       String?
  stage       String
  note        String   @default("")
  valueCents  Int      @default(0)
  marginPercent Int?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rfq       Rfq?      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([workspaceId, stage])
  @@index([rfqId, stage])
}

model SourcingTask {
  id          String   @id @default(cuid())
  workspaceId String
  rfqId       String
  requirement String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rfq       Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, requirement])
  @@index([workspaceId, status])
}

model StoredAttachment {
  id          String   @id @default(cuid())
  workspaceId String
  messageId   String
  filename    String
  contentType String
  content     Bytes
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  analyses  TenderAnalysis[]

  @@index([workspaceId, messageId])
}

model TenderAnalysis {
  id              String    @id @default(cuid())
  workspaceId     String
  rfqId           String
  attachmentId    String?
  documentType    String
  referenceNumber String    @default("")
  responseMode    String    @default("")
  analysis        Json
  approvedById    String    @default("")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rfq        Rfq                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  attachment StoredAttachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  edits      DocumentEdit[]

  @@index([workspaceId, rfqId])
  @@index([referenceNumber])
}

model DocumentEdit {
  id            String   @id @default(cuid())
  analysisId    String
  actorId       String   @default("")
  field         String
  previousValue String   @default("")
  nextValue     String   @default("")
  createdAt     DateTime @default(now())

  analysis TenderAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model InboundMessageProcessing {
  id               String    @id @default(cuid())
  workspaceId      String
  messageId        String    @default("")
  gmailMessageId   String    @unique
  threadId         String    @default("")
  processingStatus String    @default("CLAIMED")
  decision         String    @default("")
  autoReplyType    String    @default("")
  autoReplySentAt  DateTime?
  quoteId          String    @default("")
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, processingStatus])
}
